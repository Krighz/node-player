<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="260dp"
    android:layout_height="72dp"
    android:background="@drawable/bg_floating_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:id="@+id/overlay_drag_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/overlay_artwork"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            android:contentDescription="Artwork" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Node Player"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/overlay_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Touch to play"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/overlay_btn_play_pause"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_glass_play_circle"
        android:clickable="true"
        android:focusable="false"
        android:padding="8dp"
        android:src="@drawable/ic_play"
        android:contentDescription="Play/Pause" />

    <ImageView
        android:id="@+id/overlay_btn_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="false"
        android:padding="5dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Close" />
</LinearLayout>
