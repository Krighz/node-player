<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Rendered AGSL Liquid Glass Offscreen Background -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Liquid Glass Background" />

    <!-- Foreground Content Card -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- Top Row: Artwork, Title, Artist, Waveform Glyph -->
        <RelativeLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                android:contentDescription="Album Art" />

            <ImageView
                android:id="@+id/widget_glyph"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_waveform"
                android:contentDescription="Waveform Glyph" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/widget_artwork"
                android:layout_toStartOf="@id/widget_glyph"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Node Player"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Touch to play"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Middle Row: Elapsed Chronometer, Progress Bar + 20 Tap Zones, Total Time -->
        <RelativeLayout
            android:id="@+id/widget_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_header"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <Chronometer
                android:id="@+id/widget_elapsed_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <!-- FrameLayout for Progress Bar + Overlay Tap-to-seek Zones -->
            <FrameLayout
                android:id="@+id/widget_progress_container"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_toEndOf="@id/widget_elapsed_time"
                android:layout_toStartOf="@id/widget_total_time"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_centerVertical="true">

                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <!-- 20 Tap-to-Seek Touch Zones for Direct Precision Seeking -->
                <LinearLayout
                    android:id="@+id/widget_seek_zones"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="20">

                    <FrameLayout android:id="@+id/zone_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <FrameLayout android:id="@+id/zone_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                </LinearLayout>
            </FrameLayout>
        </RelativeLayout>

        <!-- Bottom Controls Row: Scrub, -10s, Prev, Play/Pause (Glass Circle), Next, +30s -->
        <LinearLayout
            android:id="@+id/widget_controls_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_btn_scrub"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_tune_seek"
                android:contentDescription="Scrub Sheet" />

            <ImageView
                android:id="@+id/widget_btn_rewind"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_replay_10"
                android:contentDescription="Rewind 10s" />

            <ImageView
                android:id="@+id/widget_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_skip_prev"
                android:contentDescription="Previous" />

            <ImageView
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_glass_play_circle"
                android:padding="10dp"
                android:src="@drawable/ic_play"
                android:contentDescription="Play/Pause" />

            <ImageView
                android:id="@+id/widget_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_skip_next"
                android:contentDescription="Next" />

            <ImageView
                android:id="@+id/widget_btn_forward"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_forward_30"
                android:contentDescription="Forward 30s" />
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>