<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Rendered AGSL Liquid Glass Offscreen Background -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Liquid Glass Background" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Top Header: Artwork, Title, Artist -->
        <RelativeLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                android:contentDescription="Album Art" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/widget_artwork"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Node Player"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Touch to play"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Center Stage: 3 Synced Lyric Lines or Empty Fallback -->
        <LinearLayout
            android:id="@+id/widget_lyrics_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_header"
            android:layout_above="@id/widget_controls_row"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Previous Line (Faded) -->
            <TextView
                android:id="@+id/widget_lyric_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#66FFFFFF"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Current Line (Large Bold Glowing) -->
            <TextView
                android:id="@+id/widget_lyric_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Next Line (Dimmed) -->
            <TextView
                android:id="@+id/widget_lyric_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#80FFFFFF"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Empty Lyrics Notice -->
            <TextView
                android:id="@+id/widget_lyrics_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No synced lyrics available"
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom Controls Row -->
        <LinearLayout
            android:id="@+id/widget_controls_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_btn_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:src="@drawable/ic_skip_prev"
                android:tint="#E6FFFFFF"
                android:contentDescription="Previous" />

            <ImageView
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_glass_play_circle"
                android:padding="9dp"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFFFF"
                android:contentDescription="Play/Pause" />

            <ImageView
                android:id="@+id/widget_btn_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:src="@drawable/ic_skip_next"
                android:tint="#E6FFFFFF"
                android:contentDescription="Next" />
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>